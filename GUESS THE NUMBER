import random

guess = random.randint (1,100)
while True:
    try:
        number = int(input("guess the number: "))
        if (number < guess):
            print (" Too low! ")
        elif (number > guess):
            print ('Too high!')
        else:
            print ('you guessed it correctly')
            break
    except ValueError:
        print ("please enter a valid number.")
